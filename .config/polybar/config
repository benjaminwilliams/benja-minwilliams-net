; frappe
[colors]
base = #303446
mantle = #292c3c
crust = #232634

text = #c6d0f5
subtext0 = #a5adce
subtext1 = #b5bfe2

surface0 = #414559
surface1 = #51576d
surface2 = #626880

overlay0 = #737994
overlay1 = #838ba7
overlay2 = #949cbb


blue = #8caaee
lavender = #babbf1
sapphire = #85c1dc
sky = #99d1db
teal = #81c8be
green = #a6d189
yellow = #e5c890
peach = #ef9f76
maroon = #ea999c
red = #e78284
mauve = #ca9ee6
pink = #f4b8e4
flamingo = #eebebe
rosewater = #f2d5cf

transparent = #FF00000
backgroundT = #88303446

[bar/example]
monitor = ${env:MONITOR:}
width = 100%
height = 30
fixed-center = true
background = #000000
foreground = #ffffff
border-size = 0
padding-left = 1
padding-right = 2
module-margin-left = 0
module-margin-right = 0
line-size = 3
radius = 0
font-0 = "DejaVuSansMono Nerd Font Mono:style=Book:size:14:antialias=true;3"


modules-left = i3
modules-center = date
modules-right = 


tray-position = right
tray-padding = 10
tray-detached = true
tray-offset-x = -5
wm-restack = i3
override-redirect = true
scroll-up = i3wm-wsnext
scroll-down = i3wm-wsprev
cursor-click = pointer
cursor-scroll = ns-resize

[module/i3]
type = internal/i3
strip-wsnumbers = true
index-sort = true
label-mode = %mode%
label-mode-padding = 2

ws-icon-0 = 1;\uf015
ws-icon-1 = 2;\uf120
ws-icon-2 = 3;\uf269
ws-icon-3 = 4;\uf07b
ws-icon-4 = 5;\uf1bc
ws-icon-5 = 6;\uf1b6;
ws-icon-6 = 7;\uf2c6;
ws-icon-7 = 8;\uf121;
ws-icon-8 = 9;\uf392;
ws-icon-default = \uf015

;label-mode-background = #e60053
; focused
label-focused = %name%
label-focused-background = ${colors.crust}
label-focused-underline = ${colors.green}
label-focused-padding = 1 
; unfocused
label-unfocused = %name%
label-unfocused-background = ${colors.mantle}
label-unfocused-padding = 1
; visible
label-visible = %name%
label-visible-underline = ${colors.mantle}
label-visible-padding = 1

[module/date]
type = internal/date
interval = 5

;date =
;date = " %Y-%m-%d"
date = "%Y-%m-%d"
;date-alt = " %Y-%m-%d"

time = %H:%M
;time-alt = %H:%M:%S

;format-prefix = 
;format-prefix-foreground = ${colors.foreground-alt}
;format-underline = #0a6cf5
label-foreground = ${colors.text}
;label-background = ${colors.background}
label-padding = 0
label = %date% %time%

[settings]
screenchange-reload = true
;compositing-background = xor
;compositing-background = screen
;compositing-foreground = source
;compositing-border = over
;pseudo-transparency = true


[global/wm]
margin-bottom = 100

